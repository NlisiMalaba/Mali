# Copy to .env on the server and replace secrets before deploy.
# docker compose -f docker-compose.prod.yml reads .env automatically.

POSTGRES_USER=mali
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=mali

DATABASE_URL=postgres://mali:replace-with-strong-db-password@postgres:5432/mali?sslmode=disable
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret

PORT=8080
ENV=production

DOMAIN=mali-api.nlisimalaba.co.zw
