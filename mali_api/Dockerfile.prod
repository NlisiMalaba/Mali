FROM golang:1.25-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/mali_api ./cmd/api

FROM golang:1.25-alpine AS migrate-builder

RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@latest

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget

COPY --from=builder /out/mali_api /usr/local/bin/mali_api
COPY --from=migrate-builder /go/bin/migrate /usr/local/bin/migrate
COPY db/migrations /migrations
COPY docs/openapi.json /docs/openapi.json

WORKDIR /

EXPOSE 8080

CMD ["mali_api"]
